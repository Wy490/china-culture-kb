  "patch_isolation_rules": [
    {
      "rule_id": "no-automatic-formal-domain-pack-patch",
      "description": "候选 Domain Pack 审稿模板不能自动写入 data/domain-packs/china-culture.json。"
    },
    {
      "rule_id": "no-province-markdown-writeback",
      "description": "Domain Pack 审稿、pass 草案准备和 repair/reject 状态均不得写入 data/provinces/*.md。"
    },
    {
      "rule_id": "pass-is-draft-preparation-only",
      "description": "pass 候选只允许生成草案准备模板，不代表真实人工审稿通过。"
    },
    {
      "rule_id": "repair-must-stay-open-until-evidence",
      "description": "repair 任务在来源、授权、事实边界或表达边界修复前保持 open。"
    },
    {
      "rule_id": "reject-requires-new-source-package",
      "description": "reject 任务必须重新取材或移除当前候选，不能复用原候选直接晋升。"
    },
    {
      "rule_id": "manual-patch-required-after-real-review",
      "description": "真实人工审稿通过后仍需人工 Patch 审核，不允许自动改正式库。"
    }
