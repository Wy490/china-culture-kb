  "evidence_slot_schema": [
    {
      "slot_id": "source_bibliography_attachment",
      "label": "来源目录附件",
      "required": true,
      "description": "官方、机构、档案、项目页、旧址资料或明确待补证来源。"
    },
    {
      "slot_id": "fact_boundary_table_attachment",
      "label": "事实边界表附件",
      "required": true,
      "description": "区分已核事实、待核事项、可影视化表达、禁止断言。"
    },
    {
      "slot_id": "authorization_or_consent_attachment",
      "label": "授权或同意附件",
      "required": true,
      "description": "场地、肖像、声音、曲词曲谱、社区、机构、档案复制件或采访授权。"
    },
    {
      "slot_id": "sample_validation_attachment",
      "label": "样本验证附件",
      "required": true,
      "description": "至少 3 个条目或项目使用验证，或明确仍不足的验证缺口。"
    },
    {
      "slot_id": "reviewer_identity_and_role_attachment",
      "label": "审稿人身份与角色附件",
      "required": true,
      "description": "记录事实、伦理、授权、片型导演等审稿角色和签署状态。"
    },
    {
      "slot_id": "final_decision_record_attachment",
      "label": "最终决策记录附件",
      "required": true,
      "description": "记录 approve / repair / reject 决策、理由、后续动作和是否允许人工 Patch。"
    }
  ],
