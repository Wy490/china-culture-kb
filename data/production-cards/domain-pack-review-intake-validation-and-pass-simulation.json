  "validation_rules": [
    {
      "rule_id": "candidate-id-must-match-known-candidate",
      "source_field_id": "candidate_id",
      "severity": "blocking",
      "description": "填报的 candidate_id 必须匹配 9 个 Phase 2 候选 Domain Pack。"
    },
    {
      "rule_id": "reviewer-name-required",
      "source_field_id": "reviewer_name",
      "severity": "blocking",
      "description": "必须填写真实审稿人姓名或可追踪审稿组名称。"
    },
    {
      "rule_id": "reviewer-role-required",
      "source_field_id": "reviewer_role",
      "severity": "blocking",
      "description": "必须填写候选包要求的审稿角色。"
    },
    {
      "rule_id": "decision-must-be-allowed",
      "source_field_id": "decision",
      "severity": "blocking",
      "description": "决策只能是 approve_for_manual_patch_candidate、repair_required 或 reject_or_rebuild。"
    },
    {
      "rule_id": "source-bibliography-required",
      "source_field_id": "source_bibliography_attachment",
      "severity": "blocking",
      "description": "必须提供来源目录附件或可追踪附件编号。"
    },
    {
      "rule_id": "fact-boundary-table-required",
      "source_field_id": "fact_boundary_table_attachment",
      "severity": "blocking",
      "description": "必须提供事实边界表，区分事实、可影视化表达、虚构和未知。"
    },
    {
      "rule_id": "authorization-consent-required",
      "source_field_id": "authorization_or_consent_attachment",
      "severity": "blocking",
      "description": "必须提供授权、同意或明确的授权缺口附件。"
    },
    {
      "rule_id": "sample-validation-required",
      "source_field_id": "sample_validation_attachment",
      "severity": "blocking",
      "description": "必须提供至少 3 个样本验证附件，或明确样本不足缺口。"
    },
    {
      "rule_id": "final-decision-reason-required",
      "source_field_id": "final_decision_reason",
      "severity": "blocking",
      "description": "必须说明最终决策理由、证据边界和后续动作。"
    },
    {
      "rule_id": "manual-patch-state-required",
      "source_field_id": "manual_patch_request_state",
      "severity": "blocking",
      "description": "必须填写 not_requested 或 requested_after_real_review。"
    },
    {
      "rule_id": "real-reviewer-signature-required",
      "source_field_id": "reviewer_identity_and_role_attachment",
      "severity": "blocking",
      "description": "进入人工 Patch 候选队列前必须有真实审稿人签署记录。"
    },
    {
      "rule_id": "validation-cannot-create-formal-patch",
      "source_field_id": "formal_patch_created",
      "severity": "blocking",
      "description": "校验通过只能进入人工 Patch 候选模拟队列，不能创建正式 Patch。"
    }
  ],
