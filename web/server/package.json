{
  "name": "china-culture-kb-server",
  "version": "0.1.0",
  "private": true,
  "description": "AI影视工作台 — Express REST API 服务端",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:audit-crash": "tsx scripts/story-generation-attempt-audit-crash-smoke.mts",
    "smoke:story-agent-full-function": "tsx scripts/story-agent-full-function-smoke.mts",
    "smoke:story-agent-cross-seed": "tsx scripts/story-agent-full-function-smoke.mts --matrix",
    "smoke:story-agent-cross-seed-images": "tsx scripts/story-agent-cross-seed-image-assets.mts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  }
}
