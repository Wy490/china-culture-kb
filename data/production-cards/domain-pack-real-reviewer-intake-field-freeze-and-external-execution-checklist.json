      "label": "正式 Patch 请求记录引用",
      "value_type": "string",
      "requirement": "conditional_required_when_explicit_formal_patch_request_true",
      "fill_policy": "external_authorized_human_input"
    }
  ],
  "intake_validation_rules": [
    {
      "rule_id": "intake-source-identifiers-must-match-handoff",
      "validation": "来源交接包、候选、证据包和填报记录 ID 必须来自本轮冻结模板。",
      "blocks_submission": true
    },
    {
      "rule_id": "reviewer-name-must-be-real-and-nonblank",
      "validation": "reviewer_name_or_group 不能为空，也不能使用 [待指定] 或模拟样例名称。",
      "blocks_submission": true
    },
    {
      "rule_id": "reviewer-identity-type-must-be-valid",
      "validation": "reviewer_identity_type 只能是 person 或 accountable_group。",
      "blocks_submission": true
    },
    {
      "rule_id": "reviewer-role-must-match-locked-role",
      "validation": "reviewer_role 必须与交接包冻结角色一致。",
      "blocks_submission": true
    },
    {
      "rule_id": "assignment-or-followup-must-match-role",
      "validation": "签署分派或修复跟进 ID 必须与冻结角色一一对应。",
      "blocks_submission": true
    },
    {
      "rule_id": "decision-must-match-review-track",
      "validation": "人工 Patch 候选只能通过或退回，修复候选只能允许重提审或要求继续补证。",
      "blocks_submission": true
    },
    {
      "rule_id": "decision-reason-must-be-nonblank",
      "validation": "决定理由不能为空。",
      "blocks_submission": true
    },
    {
      "rule_id": "all-attachment-slots-must-have-record-or-waiver",
      "validation": "6 类冻结附件槽位必须逐项有附件记录引用或有权豁免记录引用。",
      "blocks_submission": true
    },
    {
      "rule_id": "signed-at-must-have-timezone",
      "validation": "signed_at 必须是带时区的 ISO 8601 时间。",
      "blocks_submission": true
    },
    {
      "rule_id": "signature-record-reference-must-be-nonblank",
      "validation": "签署记录引用不能为空，空白模板和可打印审稿单不能作为签署引用。",
      "blocks_submission": true
    },
    {
      "rule_id": "formal-patch-request-must-have-separate-authorized-record",
      "validation": "仅当有权人员显式请求正式 Patch 时才允许为 true，并且必须提供独立请求记录引用；审稿提交本身不能创建 Patch。",
      "blocks_formal_patch": true
    }
  ],
