{
  "name": "china-culture-kb-mcp",
  "version": "0.1.0",
  "description": "AI影视工作台 MCP Server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "kb:lint": "node ../scripts/kb-lint.mjs",
    "kb:production-audit": "../web/node_modules/.bin/tsx src/tools/run-production-material-audit.ts",
    "kb:raw-field-gap-audit": "../web/node_modules/.bin/tsx src/tools/run-raw-production-field-gap-audit.ts",
    "kb:production-upgrade-plan": "../web/node_modules/.bin/tsx src/tools/run-production-material-upgrade-plan.ts",
    "kb:normalize-credibility": "../web/node_modules/.bin/tsx src/tools/run-credibility-normalization.ts",
    "kb:enrich-machine-metadata": "../web/node_modules/.bin/tsx src/tools/run-machine-metadata-enrichment.ts",
    "kb:clean-import-residue": "../web/node_modules/.bin/tsx src/tools/run-import-residue-cleanup.ts",
    "kb:asset-split-suggestions": "../web/node_modules/.bin/tsx src/tools/run-asset-split-suggestions.ts",
    "kb:draft-production-pack": "../web/node_modules/.bin/tsx src/tools/run-production-material-pack-draft.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js"
