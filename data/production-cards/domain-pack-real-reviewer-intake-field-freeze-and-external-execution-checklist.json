      "field_id": "signature_record_reference",
      "label": "签署记录引用",
      "value_type": "string",
      "requirement": "required",
      "fill_policy": "external_human_input"
    },
    {
      "field_id": "explicit_formal_patch_request",
      "label": "是否显式提出正式 Patch 请求",
