{
  "schema_version": "production-material-pack-health-conformance/v1",
  "supported_video_types": [
    "character_story",
    "historical_drama",
    "legend_story",
    "culture_promo",
    "heritage_promo",
    "city_brand_promo",
    "scene_short",
    "landscape_mood",
    "documentary_short",
    "explainer_video",
    "lecture_video",
    "education_training",
    "children_story",
    "social_short",
    "ai_comic_drama"
  ],
  "valid_domain_minimums": {
    "china_culture": 1,
    "original_fiction": 1
  },
  "standard_pack": {
    "label": "conformance pack",
    "goal": "exercise the shared production material health contract",
    "material_template": {
      "required_fields": [],
      "prompt_layers": ["one", "two", "three", "four"],
      "minimum_viable_story_gate": ["one", "two", "three"],
      "script_ready_gate": ["one", "two", "three"],
      "production_ready_gate": ["one", "two", "three"],
      "supplement_questions": ["one", "two", "three", "four"]
    }
  },
  "pack_file_structure_cases": [
    {
      "case_id": "valid_pack_file_structure",
      "expected": {
        "pack_file_valid": true,
        "loaded_pack_count": 1,
        "diagnostic": null
      }
    },
    {
      "case_id": "pack_file_root_must_be_object",
      "root_value": [],
      "expected": {
        "pack_file_valid": false,
        "loaded_pack_count": 0,
        "diagnostic": { "code": "required_object", "path": "$" }
      }
    },
    {
      "case_id": "pack_file_schema_version_is_required",
      "omit_fields": ["schema_version"],
      "expected": {
        "pack_file_valid": false,
        "loaded_pack_count": 0,
        "diagnostic": { "code": "required_non_blank_string", "path": "schema_version" }
      }
    },
    {
      "case_id": "pack_file_schema_version_must_be_string",
      "overrides": { "schema_version": 42 },
      "expected": {
        "pack_file_valid": false,
        "loaded_pack_count": 0,
        "diagnostic": { "code": "required_non_blank_string", "path": "schema_version" }
      }
    },
    {
      "case_id": "pack_file_schema_version_must_be_supported",
      "overrides": { "schema_version": "video-type-material-supplement-packs/v2-sensitive-value" },
      "expected": {
        "pack_file_valid": false,
        "loaded_pack_count": 0,
        "diagnostic": { "code": "unsupported_schema_version", "path": "schema_version" }
      }
    },
    {
      "case_id": "pack_file_packs_is_required",
      "omit_fields": ["packs"],
      "expected": {
        "pack_file_valid": false,
        "loaded_pack_count": 0,
        "diagnostic": { "code": "required_array", "path": "packs" }
      }
    },
    {
      "case_id": "pack_file_packs_must_be_array",
      "overrides": { "packs": {} },
      "expected": {
        "pack_file_valid": false,
        "loaded_pack_count": 0,
        "diagnostic": { "code": "required_array", "path": "packs" }
      }
    }
  ],
  "pack_collection_cases": [
    {
      "case_id": "duplicate_video_type_rejects_later_pack",
      "video_type": "children_story",
      "first_label": "first canonical collection pack",
      "duplicate_label": "sensitive duplicate collection pack",
      "expected": {
        "loaded_pack_count": 1,
        "selected_label": "first canonical collection pack",
        "diagnostic": {
          "pack_index": 1,
          "code": "duplicate_video_type",
          "path": "packs[1].video_type"
        }
      }
    }
  ],
