  "p0_extended_quality_rules": [
    {
      "rule_id": "p0-trauma-history-no-reenactment-expanded",
      "extends_rule_id": "p0-trauma-history-no-reenactment",
      "risk_family": "historical_trauma",
      "reject_patterns": [
        "血腥",
        "施暴",
        "刺激性暴力",
        "虚构人物说出类似真实证词",
        "虚构证词",
        "猎奇",
        "惨烈镜头",
        "受害者临终独白",
        "复仇爽感",
        "煽动仇恨"
      ],
      "caution_patterns": [
        "受害过程",
        "尸体特写",
        "哭喊复现",
        "儿童受害者视角"
      ],
      "allow_requires_any": [
        "名单墙",
        "白花",
        "安全区地图",
        "审判档案",
        "纪念馆",
        "国家公祭日",
        "幸存者口述档案说明"
      ],
      "repair_suggestions": [
        "改为证据物件、纪念空间和当代参观动作。",
        "将虚构角色限定为当代讲解员、档案整理者或观众。",
        "用来源链、名单、地图、档案盒和献花动作替代暴力再现。",
        "补充不可声称事项，避免虚构证词冒充真实证据。"
      ],
      "linked_sample_ids": [
        "p0-trauma-reject-gore-reenactment",
        "p0-trauma-pass-evidence-led"
      ]
    },
    {
      "rule_id": "p0-trauma-history-no-false-testimony",
      "extends_rule_id": "p0-trauma-history-no-reenactment",
      "risk_family": "historical_trauma",
      "reject_patterns": [
        "假托幸存者口述",
        "虚构证词",
        "编造档案编号",
        "替真实人物写遗言",
        "未经来源的第一人称回忆",
        "受害者临终独白"
      ],
      "caution_patterns": [
        "第一人称回忆",
        "真实姓名独白",
        "档案编号",
        "见证人口述"
      ],
      "allow_requires_any": [
        "来源出处",
        "档案来源",
