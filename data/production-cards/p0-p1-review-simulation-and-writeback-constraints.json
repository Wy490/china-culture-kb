  "p1_quality_rules": [
    {
      "rule_id": "p1-revolutionary-history-source-boundary",
      "risk_family": "revolutionary_history",
      "reject_patterns": [
        "虚构见证者写成真实人物",
        "唯一化第一枪断言",
        "真实人物对白无来源",
        "错置事件地点",
        "错置事件时间",
        "神化真实人物"
      ],
      "allow_requires_any": [
        "时间线来源",
        "旧址资料",
        "多说法边界",
        "展陈资料",
        "纪念馆资料"
      ],
      "repair_suggestions": [
        "把虚构见证者标注为影视化入口，不写入事实层。",
        "多说法事项只写边界，不写唯一化定论。",
        "真实人物对白必须删除或标注为不可写回。"
      ]
    },
    {
      "rule_id": "p1-ethnic-community-consent-boundary",
      "risk_family": "ethnic_community_boundary",
      "reject_patterns": [
        "未授权仪式空间",
        "内部禁忌",
        "猎奇化",
        "把公开展演写成全部传统",
        "社区未同意",
        "无来源解释纹样含义"
      ],
      "allow_requires_any": [
        "社区授权",
        "公开展演资料",
        "保护单位资料",
        "公开动作拍摄许可",
        "纹样来源"
      ],
      "repair_suggestions": [
        "把公开展演、教学展示和内部仪式空间分层。",
        "社区未授权内容只保留为补证问题。",
        "纹样含义和仪式解释必须补来源或删除。"
      ]
