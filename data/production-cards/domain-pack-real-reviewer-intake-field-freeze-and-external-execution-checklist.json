      "fill_policy": "system_prefilled_immutable"
    },
    {
      "field_id": "attachment_record_references",
      "label": "附件记录引用",
      "value_type": "array_of_slot_reference",
      "requirement": "required",
      "fill_policy": "external_human_input"
    },
    {
      "field_id": "attachment_waiver_record_references",
      "label": "附件豁免记录引用",
      "value_type": "array_of_slot_reference",
      "requirement": "optional",
