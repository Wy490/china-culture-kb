  "import_validation_rules": [
    {
      "rule_id": "import-contract-version-must-match",
      "validation": "import_contract_version 必须等于 domain-pack-real-submission-import/v1。",
      "blocks_real_import": true
    },
    {
      "rule_id": "import-envelope-id-must-not-be-fixture",
      "validation": "import_envelope_id 不能包含 fixture、simulation 或样例标记。",
      "blocks_real_import": true
    },
    {
      "rule_id": "source-record-must-be-external-and-unique",
      "validation": "source_system、source_record_id 和 idempotency_key 必须非空，且不能指向本仓库模拟夹具。",
      "blocks_real_import": true
    },
    {
      "rule_id": "payload-digest-must-be-valid-sha256",
      "validation": "payload_digest_sha256 必须是 64 位小写十六进制摘要。",
      "blocks_real_import": true
    },
    {
      "rule_id": "route-identifiers-must-match-frozen-intake",
      "validation": "交接包、填报模板、候选、角色、分派和证据包必须与冻结导入路由一致。",
      "blocks_real_import": true
    },
    {
      "rule_id": "reviewer-identity-record-must-resolve",
      "validation": "真实审稿人姓名、主体类型和身份记录引用必须由外部身份解析器验证。",
      "blocks_real_import": true
    },
    {
      "rule_id": "role-and-assignment-must-match",
      "validation": "reviewer_role 与 assignment_or_followup_id 必须匹配冻结路由。",
      "blocks_real_import": true
    },
    {
      "rule_id": "decision-and-reason-must-match-review-track",
      "validation": "决定值必须属于对应审稿轨道，且决定理由非空。",
      "blocks_real_import": true
    },
    {
      "rule_id": "evidence-package-must-match-route",
      "validation": "evidence_package_id 必须匹配冻结路由。",
      "blocks_real_import": true
    },
    {
      "rule_id": "all-six-attachment-slots-must-resolve",
      "validation": "attachment_record_manifest 必须覆盖 6 个唯一槽位，每项均解析到真实附件或有权豁免记录。",
      "blocks_real_import": true
    },
    {
      "rule_id": "all-record-references-must-reject-simulation",
      "validation": "任何身份、附件、签署或 Patch 请求记录引用都不能包含 SIMULATION、fixture 或结构校验占位。",
      "blocks_real_import": true
    },
    {
      "rule_id": "signature-record-and-time-must-resolve",
      "validation": "signed_at 必须带时区，signature_record_reference 必须由外部签署解析器验证。",
      "blocks_real_import": true
    },
    {
      "rule_id": "formal-patch-request-must-be-separate-and-resolved",
      "validation": "只有 explicit_formal_patch_request=true 时才要求独立 Patch 请求记录，且该记录必须由授权解析器验证；导入本身不创建 Patch。",
      "blocks_real_import": true
    },
    {
      "rule_id": "submitter-attestation-must-reject-template-data",
      "validation": "提交者必须声明数据不是 fixture、simulation、空白模板或自动生成签署，并对来源准确性负责。",
      "blocks_real_import": true
    }
  ],
  "simulation_rejection_rules": [
    {
      "rule_id": "reject-fixture-identifiers",
      "match_targets": [
        "import_envelope_id",
        "source_record_id",
        "reviewer_intake_id"
      ],
      "rejected_patterns": [
        "submission-fixture-",
        "fixture_id",
        "validation_fixture"
      ],
      "action": "reject_real_import"
    },
    {
      "rule_id": "reject-simulation-record-references",
      "match_targets": [
        "reviewer_identity_record_reference",
        "attachment_record_manifest.*.record_reference",
        "signature_record_reference",
        "formal_patch_request_record_reference"
      ],
      "rejected_patterns": [
        "SIMULATION-",
        "simulation-attachment-set-"
      ],
      "action": "reject_real_import"
    },
    {
      "rule_id": "reject-structural-placeholder-values",
      "match_targets": [
        "reviewer_name_or_group",
        "decision_reason"
      ],
      "rejected_patterns": [
        "结构校验占位",
        "结构校验文本",
        "[待指定]"
      ],
      "action": "reject_real_import"
    },
    {
      "rule_id": "reject-simulation-flags-and-fixture-metadata",
      "match_targets": [
        "simulation_only",
        "fixture_validation_mode",
        "derived_from_fixture_id"
      ],
      "rejected_values": [
        true,
        "field_present"
      ],
      "action": "reject_real_import"
    }
  ],
