  "required_field_rules": [
    {
      "field_id": "candidate_id",
      "label": "候选包 ID",
      "required": true,
      "validation": "must_match_domain_pack_candidate"
    },
    {
      "field_id": "reviewer_name",
      "label": "审稿人姓名",
      "required": true,
      "validation": "must_be_real_person_or_named_review_group"
    },
    {
      "field_id": "reviewer_role",
      "label": "审稿角色",
      "required": true,
      "validation": "must_match_required_reviewer_roles"
    },
    {
      "field_id": "decision",
      "label": "审稿决策",
      "required": true,
      "validation": "approve_for_manual_patch_candidate|repair_required|reject_or_rebuild"
    },
    {
      "field_id": "source_bibliography_attachment",
      "label": "来源目录附件",
      "required": true,
      "validation": "must_reference_attachment_or_tracking_id"
    },
    {
      "field_id": "fact_boundary_table_attachment",
      "label": "事实边界表附件",
      "required": true,
      "validation": "must_separate_fact_plausible_dramatization_fiction_unknown"
    },
    {
      "field_id": "authorization_or_consent_attachment",
      "label": "授权或同意附件",
      "required": true,
      "validation": "must_reference_rights_consent_or_explicit_gap"
    },
    {
      "field_id": "sample_validation_attachment",
      "label": "样本验证附件",
      "required": true,
      "validation": "must_reference_at_least_three_samples_or_explicit_gap"
    },
    {
      "field_id": "final_decision_reason",
      "label": "最终决策理由",
      "required": true,
      "validation": "must_explain_evidence_boundary_and_followup_action"
    },
    {
      "field_id": "manual_patch_request_state",
      "label": "人工 Patch 请求状态",
      "required": true,
      "validation": "not_requested|requested_after_real_review"
    }
  ],
