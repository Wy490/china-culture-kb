  "signature_feedback_rules": [
    {
      "rule_id": "owner-must-be-real-person-or-group",
      "label": "签署反馈必须提供真实负责人或可追责小组",
      "validation": "owner 字段不能继续保留 [待指定] 或空值",
      "blocks_formal_patch": true
    },
    {
      "rule_id": "signature-role-must-match-assignment",
      "label": "签署角色必须匹配预审分派",
      "validation": "assignment_id、signature_id、assigned_role 必须来自第 20 轮催办看板",
      "blocks_formal_patch": true
    },
    {
      "rule_id": "signature-state-must-be-signed-or-rejected",
      "label": "签署状态必须是明确通过或退回",
      "validation": "真实流程中不能以 blank / pending 冒充签署完成；本轮样例只允许验证格式",
      "blocks_formal_patch": true
    },
    {
      "rule_id": "attachment-package-must-have-files",
      "label": "审稿包必须有实际附件文件",
      "validation": "attachment_file_committed 必须来自真实附件提交，本轮锁版保持 false",
      "blocks_formal_patch": true
    },
    {
      "rule_id": "all-frozen-slots-must-be-addressed",
      "label": "冻结附件槽位必须全部处理",
      "validation": "来源目录、事实边界、授权、样本验证、审稿人身份、最终决策记录 6 类槽位都必须有提交或明确豁免",
      "blocks_formal_patch": true
    },
    {
      "rule_id": "signed-feedback-cannot-create-formal-patch",
      "label": "签署反馈不能直接创建正式 Patch",
      "validation": "即使未来真实签署完成，也必须由人工显式请求正式 Patch",
      "blocks_formal_patch": true
    },
    {
      "rule_id": "audit-lint-runbook-waits-for-formal-patch",
      "label": "audit/lint 运行清单仍等待正式 Patch 后执行",
      "validation": "本轮不能把 runbook 当成已经运行的结果",
      "blocks_formal_patch": true
    },
    {
      "rule_id": "no-province-writeback",
      "label": "禁止直接写回省份 Markdown",
      "validation": "签署反馈、锁版包、失败原因索引均不得写入 data/provinces/*.md",
      "blocks_formal_patch": true
    }
  ],
